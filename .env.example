# Gere SECRET_KEY com secrets.token_urlsafe(64). Nunca reutilize valores de teste.
SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=agenda.seu-dominio.br
PUBLIC_URL=https://agenda.seu-dominio.br
CSRF_TRUSTED_ORIGINS=https://agenda.seu-dominio.br
MAIL_MODE=smtp
# Para Resend, use MAIL_MODE=resend: a aplicação envia pela API HTTPS do Resend.
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
# Em produção, prefira PostgreSQL gerenciado. DATABASE_URL substitui DATABASE_PATH.
# DATABASE_URL=postgresql://usuario:senha@host:5432/tvtec_agenda
